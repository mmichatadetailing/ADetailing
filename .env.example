# Supabase — laisser vide pour utiliser le mode démonstration local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chiffrement serveur des jetons OAuth (32 octets encodés en base64)
OAUTH_TOKEN_ENCRYPTION_KEY=

# Google Calendar OAuth — connexion individuelle des calendriers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL publique de l’application
NEXT_PUBLIC_APP_URL=http://localhost:3000
